{
  "manifest_version": 3,
  "name": "Yamina – Auto RTL for Hebrew & Arabic",
  "short_name": "Yamina",
  "version": "0.3.1",
  "description": "Right-aligns Hebrew and Arabic text on the sites you switch it on for.",
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Yamina: off for this site. Click to turn on.",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
